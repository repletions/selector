local function cleanrig(rig)
    for _, obj in ipairs(rig:GetDescendants()) do
        if obj:IsA("BaseScript") or obj:IsA("Sound") or (obj:IsA("Highlight") and obj.Name == "cac_visual") or obj:IsA("SelectionBox") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.LocalTransparencyModifier = 0 -- garante que vem visivel no save
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.LocalTransparencyModifier = 0
        end
    end
end

-- Clone() pula qualquer descendente com Archivable = false (SurfaceAppearance, MeshPart, Decal, acessorios...),
-- entao eles sumiam do export. liga Archivable em tudo so durante o clone e restaura o valor original depois.
local function clonewithdescendants(rig)
    local changed = {}
    local function mark(inst)
        local okread, arch = pcall(function() return inst.Archivable end)
        if okread and arch == false then
            local okset = pcall(function() inst.Archivable = true end)
            if okset then table.insert(changed, inst) end
        end
    end

    mark(rig)
    for _, d in ipairs(rig:GetDescendants()) do mark(d) end

    local s, clone = pcall(function() return rig:Clone() end)

    for _, inst in ipairs(changed) do
        pcall(function() inst.Archivable = false end)
    end
    return s, clone
end

-- universal syn saveinstance (rbxlx repo). se falhar o load, cai no fallback de workspace do exportselected
local synsaveinstance
do
    local Params = {
        RepoURL = "https://raw.githubusercontent.com/rbxlx/UniversalSynSaveInstance/main/",
        SSI = "saveinstance",
    }
    local okload, loaded = pcall(function()
        return loadstring(game:HttpGet(Params.RepoURL .. Params.SSI .. ".luau", true), Params.SSI)()
    end)
    if okload and loaded ~= nil then synsaveinstance = loaded end
end

local function exportselected()
    if #state.selected == 0 then return false end

    local exportfolder = Instance.new("Folder")
    exportfolder.Name = "CAC_Extraidos_" .. os.time()
    local count = 0

    for _, rig in ipairs(table.clone(state.selected)) do
        local s, clone = clonewithdescendants(rig)
        if not (s and clone) then
            warn("[cac] falhou ao clonar rig: " .. tostring(rig.Name))
        end

        if s and clone then
            count = count + 1
            clone.Name = rig.Name .. "_CAC_" .. count
            cleanrig(clone)

            local row = math.floor((count - 1) / 10)
            local col = (count - 1) % 10
            
            local cframe = CFrame.new(col * 7, 5, row * 7)
            if clone.PrimaryPart then
                clone:PivotTo(cframe)
            else
                local root = getroot(clone)
                if root then
                    local offset = clone:GetPivot():ToObjectSpace(root.CFrame)
                    clone:PivotTo(cframe * offset:Inverse())
                else
                    clone:MoveTo(cframe.Position)
                end
            end
            
            clone.Parent = exportfolder
            if count % 15 == 0 then task.wait() end
        end
    end

    if synsaveinstance then
        local ok, err = pcall(function()
            synsaveinstance({
                mode = "invalid",
                ExtraInstances = {exportfolder},
                IsModel = true,
                FilePath = exportfolder.Name,
                SafeMode = false,
            })
        end)
        exportfolder:Destroy()
        
        if ok then
            for _, r in ipairs(state.selected) do removehighlight(r) end
            table.clear(state.selected)
            return true
        end
    else
        exportfolder.Parent = workspace
        for _, r in ipairs(state.selected) do removehighlight(r) end
        table.clear(state.selected)
        return true
    end
    
    return false
end

