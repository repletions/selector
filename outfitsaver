-- ============================================================================
-- utils e funcoes base
-- ============================================================================

local function isrig(obj)
    if not obj then return false end
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        if obj == lp.Character then return false end
        return true
    end
    return false
end

local function getroot(rig)
    return rig.PrimaryPart or rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChild("Torso") or rig:FindFirstChild("UpperTorso")
end

local function applyhighlight(rig, color, transp)
    if not rig then return end
    
    if state.highlights[rig] then
        state.highlights[rig].FillColor = color
        state.highlights[rig].FillTransparency = transp
        return
    end

    local hl = Instance.new("Highlight")
    hl.Name = "cac_visual"
    hl.FillColor = color
    hl.FillTransparency = transp
    hl.OutlineColor = color
    hl.OutlineTransparency = 0.2
    hl.Adornee = rig
    
    local ok, err = pcall(function() hl.Parent = coregui end)
    if not ok then hl.Parent = rig end
    
    state.highlights[rig] = hl
end

local function removehighlight(rig)
    if state.highlights[rig] then
        state.highlights[rig]:Destroy()
        state.highlights[rig] = nil
    end
end

local function toggleselection(rig)
    if not rig then return end
    if state.exporting then return end
    
    local found = false
    for i, v in ipairs(state.selected) do
        if v == rig then
            found = i
            break
        end
    end

    if found then
        table.remove(state.selected, found)
        removehighlight(rig)
    else
        table.insert(state.selected, rig)
        applyhighlight(rig, selectcolor, 0.6)
    end
end

-- ============================================================================
-- sistema de selecao por clique (inspector)
-- ============================================================================

local currenthover = nil

runservice.RenderStepped:Connect(function()
    if not state.clickmode then
        if currenthover and not table.find(state.selected, currenthover) then
            removehighlight(currenthover)
            currenthover = nil
        end
        return
    end

    local target = mouse.Target
    local newhover = nil

    if target then
        local model = target:FindFirstAncestorOfClass("Model")
        if isrig(model) then
            newhover = model
        elseif isrig(target) then
            newhover = target
        end
    end

    if currenthover ~= newhover then
        if currenthover and not table.find(state.selected, currenthover) then
            removehighlight(currenthover)
        end
        currenthover = newhover
        if currenthover and not table.find(state.selected, currenthover) then
            applyhighlight(currenthover, hovercolor, 0.8)
        end
    end
end)

uis.InputBegan:Connect(function(input, gameprocessed)
    if gameprocessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and state.clickmode then
        if currenthover then
            toggleselection(currenthover)
        end
    end
end)

-- ============================================================================
-- render culling profissional (batching para n travar)
-- ============================================================================

local function updateculling()
    if not state.culling then return end
    local char = lp.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cam = workspace.CurrentCamera
    local campos = cam.CFrame.Position

    local allrigs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isrig(obj) then table.insert(allrigs, obj) end
    end

    -- processa em lotes pra nao dar frame drop
    task.spawn(function()
        for i, rig in ipairs(allrigs) do
            local rigroot = getroot(rig)
            if rigroot then
                local dist = (campos - rigroot.Position).Magnitude
                local isfar = dist > state.renderdist and not table.find(state.selected, rig)
                
                for _, part in ipairs(rig:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
                        -- localtransparencymodifier esconde visualmente sem alterar a transparencia real pro save
                        if isfar then
                            if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
                            if part:IsA("Decal") or part:IsA("Texture") then part.LocalTransparencyModifier = 1 end
                        else
                            if part:IsA("BasePart") then part.LocalTransparencyModifier = 0 end
                            if part:IsA("Decal") or part:IsA("Texture") then part.LocalTransparencyModifier = 0 end
                        end
                    end
                end
            end
            if i % 50 == 0 then task.wait() end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        updateculling()
    end
end)

