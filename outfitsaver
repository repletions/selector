-- ================== descoberta de rigs + selecao em massa ==================
-- cada lista (src) guarda os rigs do ultimo scan POR REFERENCIA de Instance (nunca por nome).
-- a fila de export continua sendo state.selected, compartilhada com o modo clique.

local MAXSHOWN = 200            -- maximo de itens no dropdown; Select All continua pegando TODOS os rigs do scan
local MAXBULKHIGHLIGHTS = 31    -- a engine so renderiza ~31 Highlights ao mesmo tempo, mais que isso e custo sem efeito
local SCANYIELD = 3000          -- instancias processadas por frame durante o scan (evita travar a UI)

local function notify(title, content)
    pcall(function()
        rayfield:Notify({Title = title, Content = content, Duration = 5})
    end)
end

local function toset(list)
    local set = {}
    for _, v in ipairs(list) do set[v] = true end
    return set
end

local function counthighlights()
    local n = 0
    for _ in pairs(state.highlights) do n = n + 1 end
    return n
end

-- valida o Humanoid achado e devolve o Model-rig, ou nil + motivo da exclusao
local function validaterig(hum)
    local model = hum.Parent
    if not model then
        return nil, "Humanoid sem parent (destruido durante o scan)"
    end
    if not model:IsA("Model") then
        return nil, "o parent do Humanoid nao e um Model (e " .. model.ClassName .. ")"
    end
    if model == lp.Character then
        return nil, "e o seu proprio personagem"
    end
    local anc = model.Parent
    while anc do
        if anc:IsA("Folder") and string.find(anc.Name, "^CAC_Extraidos_") then
            return nil, "dentro de uma pasta de export deste script (CAC_Extraidos_)"
        end
        anc = anc.Parent
    end
    if not model:FindFirstChildWhichIsA("BasePart", true) then
        return nil, "sem nenhuma BasePart (nada visual pra exportar)"
    end
    return model
end

-- varre root recursivamente (pastas, models, qualquer container). cada Model com Humanoid direto entra uma vez so.
local function scanrigs(root)
    local rigs, seen, skipped = {}, {}, {}
    local dupes = 0
    local descendants = root:GetDescendants()
    for i, obj in ipairs(descendants) do
        if obj.ClassName == "Humanoid" then
            local model, reason = validaterig(obj)
            if model then
                if seen[model] then
                    dupes = dupes + 1
                else
                    seen[model] = true
                    table.insert(rigs, model)
                end
            else
                table.insert(skipped, {inst = obj, reason = reason})
            end
        end
        if i % SCANYIELD == 0 then task.wait() end
    end
    table.sort(rigs, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)
    return rigs, skipped, dupes
end

local function makesource(title, root)
    return {
        title = title, root = root,
        rigs = {}, set = {},
        shown = {}, labels = {}, labelmap = {},
        filter = "", matches = 0,
        scanning = false, scanned = false,
        syncing = false, lastkey = "", lastinfo = "",
    }
end

local function belongs(src, rig)
    return src.set[rig] == true or rig:IsDescendantOf(src.root)
end

local function countselected(src)
    local k = 0
    for _, r in ipairs(state.selected) do
        if belongs(src, r) then k = k + 1 end
    end
    return k
end

local function updateinfo(src)
    if not src.info then return end
    local text
    if not src.scanned then
        text = "no scan yet - press Refresh List | queue: " .. #state.selected
    else
        text = string.format("found: %d | listed: %d | selected here: %d | queue: %d",
            #src.rigs, #src.shown, countselected(src), #state.selected)
    end
    if text ~= src.lastinfo then
        src.lastinfo = text
        pcall(function() src.info:Set(text) end)
    end
end

-- chave dos itens listados que estao selecionados (usada pra detectar mudanca externa: modo clique, limpar fila, export)
local function selectedkey(src)
    local selset = toset(state.selected)
    local parts = {}
    for i, rig in ipairs(src.shown) do
        if selset[rig] then parts[#parts + 1] = i end
    end
    return table.concat(parts, ",")
end

-- alinha o visual do dropdown com state.selected (o callback do dropdown e idempotente, entao Set nao causa loop)
local function syncdropdown(src)
    if not src.dropdown then return end
    local selset = toset(state.selected)
    local current, parts = {}, {}
    for i, rig in ipairs(src.shown) do
        if selset[rig] then
            table.insert(current, src.labels[i])
            parts[#parts + 1] = i
        end
    end
    src.lastkey = table.concat(parts, ",")
    src.syncing = true
    pcall(function() src.dropdown:Set(current) end)
    src.syncing = false
end

-- monta o dropdown a partir do scan + filtro. label unica por rig (#indice), mapeada pra Instance em labelmap
local function rebuilddropdown(src)
    local filter = string.lower(src.filter)
    table.clear(src.shown)
    table.clear(src.labels)
    table.clear(src.labelmap)
    local matches = 0
    for i, rig in ipairs(src.rigs) do
        if filter == "" or string.find(string.lower(rig.Name), filter, 1, true) then
            matches = matches + 1
            if #src.shown < MAXSHOWN then
                local parent = rig.Parent
                local label = string.format("%s  #%d  (%s)", rig.Name, i, parent and parent.Name or "?")
                table.insert(src.shown, rig)
                table.insert(src.labels, label)
                src.labelmap[label] = rig
            end
        end
    end
    src.matches = matches

    local options = table.clone(src.labels)
    if #options == 0 then
        options = {src.scanned and "no rigs match" or "press Refresh List first"}
    end
    pcall(function() src.dropdown:Refresh(options) end)
    syncdropdown(src)
    updateinfo(src)
end

-- adiciona a state.selected sem duplicar (O(n) com set, nao O(n^2)); highlight so pra rigs do workspace e ate o limite
local function addrigs(list)
    local selset = toset(state.selected)
    local added = {}
    for _, rig in ipairs(list) do
        if not selset[rig] then
            selset[rig] = true
            table.insert(state.selected, rig)
            table.insert(added, rig)
        end
    end
    local used = counthighlights()
    for _, rig in ipairs(added) do
        if used >= MAXBULKHIGHLIGHTS then break end
        if not state.highlights[rig] and rig:IsDescendantOf(workspace) then
            applyhighlight(rig, selectcolor, 0.6)
            used = used + 1
        end
    end
    return #added
end

-- remove de state.selected mantendo a mesma tabela (outras partes do script referenciam state.selected)
local function removerigs(list)
    local rm = toset(list)
    local old = table.clone(state.selected)
    table.clear(state.selected)
    local removed = 0
    for _, rig in ipairs(old) do
        if rm[rig] then
            removed = removed + 1
            removehighlight(rig)
        else
            table.insert(state.selected, rig)
        end
    end
    return removed
end

local function reportskipped(src, skipped, dupes)
    local groups, order = {}, {}
    for _, s in ipairs(skipped) do
        local g = groups[s.reason]
        if not g then
            g = {count = 0, examples = {}}
            groups[s.reason] = g
            table.insert(order, s.reason)
        end
        g.count = g.count + 1
        if #g.examples < 5 then
            local ok, path = pcall(function() return s.inst:GetFullName() end)
            table.insert(g.examples, ok and path or "?")
        end
    end
    for _, reason in ipairs(order) do
        local g = groups[reason]
        warn(string.format("[cac] %s: %d Humanoid(s) excluido(s) - %s", src.title, g.count, reason))
        for _, path in ipairs(g.examples) do
            print("[cac]    ex: " .. path)
        end
    end
    if dupes > 0 then
        print(string.format("[cac] %s: %d Humanoid(s) extra no mesmo Model foram unidos (rig contado uma vez)", src.title, dupes))
    end
end

local function refreshsource(src)
    if src.scanning then
        notify(src.title, "a scan is already running")
        return
    end
    if state.exporting then
        notify(src.title, "export in progress - wait before refreshing")
        return
    end
    src.scanning = true
    local ok, rigs, skipped, dupes = pcall(scanrigs, src.root)
    src.scanning = false
    if not ok then
        warn("[cac] scan falhou (" .. src.title .. "): " .. tostring(rigs))
        notify(src.title, "scan failed - see console")
        return
    end

    -- rigs do scan anterior que sumiram (destruidos ou movidos pra fora da raiz) saem da fila, com aviso
    local stale = {}
    for rig in pairs(src.set) do
        if not rig:IsDescendantOf(src.root) then table.insert(stale, rig) end
    end
    local pruned = removerigs(stale)

    src.rigs = rigs
    src.set = toset(rigs)
    src.scanned = true
    rebuilddropdown(src)
    reportskipped(src, skipped, dupes)

    local msg = string.format("%d rigs found, %d excluded", #rigs, #skipped)
    if #skipped > 0 then msg = msg .. " (reasons in console)" end
    if pruned > 0 then msg = msg .. string.format(", %d selected rigs no longer exist and were removed from the queue", pruned) end
    notify(src.title, msg)
end

local function selectall(src)
    if state.exporting then
        notify(src.title, "export in progress - selection is locked")
        return
    end
    if not src.scanned or #src.rigs == 0 then
        notify(src.title, "nothing to select - press Refresh List first")
        return
    end
    local valid, stale = {}, 0
    for _, rig in ipairs(src.rigs) do
        if rig:IsDescendantOf(src.root) then
            table.insert(valid, rig)
        else
            stale = stale + 1
        end
    end
    local added = addrigs(valid)
    syncdropdown(src)
    updateinfo(src)
    local msg = string.format("%d rigs added to the queue (%d were already selected)", added, #valid - added)
    if stale > 0 then msg = msg .. string.format(", %d no longer exist - press Refresh List", stale) end
    notify(src.title, msg)
end

local function deselectall(src)
    if state.exporting then
        notify(src.title, "export in progress - selection is locked")
        return
    end
    local list = {}
    for _, r in ipairs(state.selected) do
        if belongs(src, r) then table.insert(list, r) end
    end
    local removed = removerigs(list)
    syncdropdown(src)
    updateinfo(src)
    notify(src.title, string.format("%d rigs removed from the queue", removed))
end

local function buildrigtab(tab, src, dropname, dropflag, filterflag)
    tab:CreateSection(src.title .. " rigs")

    src.info = tab:CreateLabel("no scan yet - press Refresh List")

    tab:CreateButton({
        Name = "Refresh List (" .. src.title .. ")",
        Callback = function() refreshsource(src) end,
    })

    tab:CreateButton({
        Name = "Select All (" .. src.title .. ")",
        Callback = function() selectall(src) end,
    })

    tab:CreateButton({
        Name = "Deselect All (" .. src.title .. ")",
        Callback = function() deselectall(src) end,
    })

    tab:CreateInput({
        Name = "Filter list by name (optional)",
        PlaceholderText = "type part of a name",
        RemoveTextAfterFocusLost = false,
        Flag = filterflag,
        Callback = function(text)
            src.filter = text or ""
            if src.scanned then rebuilddropdown(src) end
        end,
    })

    src.dropdown = tab:CreateDropdown({
        Name = dropname,
        Options = {"press Refresh List first"},
        CurrentOption = {""},
        MultipleOptions = true,
        Flag = dropflag,
        Callback = function(options)
            if src.syncing or state.exporting then return end
            if type(options) == "string" then options = {options} end
            local want = {}
            for _, label in ipairs(options) do
                local rig = src.labelmap[label]
                if rig then want[rig] = true end
            end
            -- so reconcilia os itens listados; rigs fora do dropdown (limite/filtro) nao sao tocados
            local selset = toset(state.selected)
            local toadd, toremove = {}, {}
            for _, rig in ipairs(src.shown) do
                if want[rig] and not selset[rig] then
                    table.insert(toadd, rig)
                elseif not want[rig] and selset[rig] then
                    table.insert(toremove, rig)
                end
            end
            addrigs(toadd)
            removerigs(toremove)
            src.lastkey = selectedkey(src)
            updateinfo(src)
        end,
    })
end

